# ──────────────────────────────────────────────────────────────
# Crunchrr — root env template
# Copy the relevant block into each app's own env file:
#   apps/api/.env       (server-side secrets)
#   apps/web/.env.local (browser + Next.js build env)
# Never commit the real files.
# ──────────────────────────────────────────────────────────────

# ── apps/api/.env ─────────────────────────────────────────────
# Neon Postgres (project: crunchrr-shop) — get from Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/crunchrr?sslmode=require

# Clerk (project: crunchrr-shop) — Backend API keys from Clerk dashboard
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# CORS: comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Razorpay — real webhook secret from dashboard (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=whsec_your_real_secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Force demo payment mode (no real gateway calls; webhook confirm simulated).
# Leave unset (or false) in production.
FORCE_DEMO_PAYMENTS=true

# ── apps/web/.env.local ───────────────────────────────────────
# API base URLs
NEXT_PUBLIC_API_URL=http://localhost:4001
API_INTERNAL_URL=http://localhost:4001

# Clerk — same keys as API (publishable is public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Public site URL (used for metadata/JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
