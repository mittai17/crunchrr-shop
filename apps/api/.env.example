# Crunchrr API — production-shaped environment template.
# Copy to .env and fill in real credentials.

NODE_ENV=development
API_PORT=4001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Neon Postgres — pooled connection string from `neon projects create`
DATABASE_URL=

# CORS origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000

# Clerk backend (sk_/pk_ from `clerk env pull`)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Razorpay dashboard → Settings → API Keys + Webhooks secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree merchant panel credentials
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Partner fulfillment credentials
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
PRINTROVE_EMAIL=
PRINTROVE_PASSWORD=

# Force demo payment mode even with keys present (local QA)
FORCE_DEMO_PAYMENTS=false

# Admin panel gate — Clerk user ids allowed to reach /admin + /api/admin/*.
# ADMIN_DEV_BYPASS=true lets ANY signed-in user in non-production only.
ADMIN_CLERK_USER_IDS=
ADMIN_DEV_BYPASS=false
