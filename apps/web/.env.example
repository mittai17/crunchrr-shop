# Crunchrr Web — environment template
# Copy to .env.local

# Fastify API (public, browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:4001
# Fastify API (internal, server components — same host in prod)
API_INTERNAL_URL=http://localhost:4001
# Clerk (pk_/sk_ from `clerk env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel gate (mirrors the API env) — dev bypass is dev-only.
ADMIN_CLERK_USER_IDS=
ADMIN_DEV_BYPASS=false
